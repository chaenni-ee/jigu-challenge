rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 학급 설정(app/meta), 학생 비밀번호(app/pins), 미션 기록(app/progress)
    match /app/{docId} {
      allow read: if docId in ['meta', 'pins', 'progress'];
      allow write: if docId in ['meta', 'pins', 'progress']
                   && request.resource.size() < 900000;
    }
    // 인증 사진: 같은 학생·미션·날짜는 한 번만 올릴 수 있어요(덮어쓰기 금지).
    match /photos/{photoId} {
      allow read: if true;
      allow create: if request.resource.data.data is string
                    && request.resource.data.data.size() < 950000
                    && photoId == request.resource.data.sid + '_' + request.resource.data.mid + '_' + request.resource.data.date;
      allow update: if false;
      allow delete: if true; // 교사 화면에서 잘못 올린 사진을 지울 때 사용
    }
  }
}
